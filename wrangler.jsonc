// Cloudflare Worker: the app's files, the API, the live connection and the cron (ADR-004).
// Secrets are not here: set GOOGLE_CLIENT_SECRET, BOOTSTRAP_ADMIN_EMAILS and TMDB_API_KEY with
// `npx wrangler secret put <NAME>`, and locally in .dev.vars (see .dev.vars.example).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pacoca-auwards",
  "main": "server/entry/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GROUP", "class_name": "Group" }]
  },
  // Never edit a shipped migration; add the next tag.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Group"] }],
  // One cron for every time-based job; each job decides whether it is due (GroupService.tick).
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // Public: the OAuth client ID from Google Cloud. Set here, not in the dashboard: a deploy
    // overwrites dashboard variables with these. The client secret is a secret.
    "GOOGLE_CLIENT_ID": "625557632408-0rsie0euo04saggbktbfsoiandias8as.apps.googleusercontent.com"
  },
  // Branch previews (`wrangler preview`, ADR-004) refuse to deploy without this block. Each preview
  // gets its own empty Group namespace, never production's data; it has no secrets and no cron, and
  // Google sign-in does not work there (ADR-005), so the public client ID is enough.
  "previews": {
    "vars": {
      "GOOGLE_CLIENT_ID": "625557632408-0rsie0euo04saggbktbfsoiandias8as.apps.googleusercontent.com"
    },
    "durable_objects": {
      "bindings": [{ "name": "GROUP", "class_name": "Group" }]
    }
  },
  // Pede pra Paçoca (ADR-009). Turn on once its Worker exposes the read-only entrypoint; until then
  // the app hides the import and the sign-in by Pede. Use the names from that repository:
  // "services": [{ "binding": "PEDE", "service": "<pede-worker-name>", "entrypoint": "<EntrypointClass>" }],
  "observability": { "enabled": true },
  // No Wrangler usage telemetry from builds or CI (docs/SEGURANCA.md).
  "send_metrics": false
}
